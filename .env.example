# =====================================================================
# Configuration base de données — copier ce fichier en .env
#   cp .env.example .env
# =====================================================================

# --- LOCAL (docker-compose --profile localdb) ---
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=electio
# DB_USER=electio
# DB_PASSWORD=electio
# DB_SSLMODE=

# --- AIVEN (base distante) ---
# Récupérer ces valeurs dans la console Aiven > Connection information
DB_HOST=pg-xxxx.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=<mot_de_passe_aiven>
DB_SSLMODE=require
# Certificat CA Aiven (téléchargé depuis la console > CA certificate)
DB_SSLROOTCERT=db/aiven-ca.pem

# --- DATALAKE MinIO (optionnel, profil docker compose `datalake`) ---
# MINIO_ENDPOINT=localhost:9010
# MINIO_ACCESS_KEY=electio
# MINIO_SECRET_KEY=electioelectio
# MINIO_BUCKET=electio-datalake
# MINIO_SECURE=0
